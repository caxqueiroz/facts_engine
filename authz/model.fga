model
  schema 1.1

type user

type service

type tenant
  relations
    define member: [user, service]

type scope
  relations
    define tenant: [tenant]
    define tenant_member: member from tenant
    define reader: [user, service]
    define proposer: [user, service]
    define approver: [user, service]
    define confirmation_recorder: [service]
    define can_record_delegated_attestation: confirmation_recorder and tenant_member
    define attestor: [user, service]
    define acceptor: [service]
    define administrator: [user, service]
    define auditor: [user, service]
    define retention_administrator: [user, service]
    define legal_custodian: [user, service]
    define disposal_operator: [user, service]
    define can_manage_retention: retention_administrator and tenant_member
    define can_manage_legal_hold: legal_custodian and tenant_member
    define can_dispose: disposal_operator and tenant_member
    define operator: [user, service]
    define can_read: reader and tenant_member
    define can_extract: proposer and tenant_member
    define can_ingest: proposer and tenant_member
    define can_ingest_organization_record: administrator and tenant_member
    define can_propose: proposer and tenant_member
    define can_approve: approver and tenant_member
    define can_attest: attestor and tenant_member
    define can_accept: acceptor and tenant_member
    define can_manage_identities: administrator and tenant_member
    define can_manage_definitions: administrator and tenant_member
    define can_read_history: auditor and tenant_member
    define can_read_evidence_metadata: reader and tenant_member
    define can_read_evidence: auditor and tenant_member
    define can_dispute: proposer and tenant_member
    define can_resolve: approver and tenant_member
    define can_snapshot: reader and tenant_member
    define can_record_calculation: proposer and tenant_member
    define can_prepare_context: reader and tenant_member
    define can_record_decision: proposer and tenant_member
    define can_export_audit: auditor and tenant_member
    define can_operate: operator and tenant_member
